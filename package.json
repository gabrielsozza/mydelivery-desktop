{
  "name": "mydelivery-desktop",
  "productName": "MyDelivery",
  "version": "1.0.0",
  "description": "MyDelivery Desktop — abre o painel MyDelivery numa janela de app com impressão automática nativa.",
  "author": "MyDelivery",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.mydeliveryfood.desktop",
    "productName": "MyDelivery",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "print.js", "build/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "MyDelivery-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MyDelivery"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.business",
      "artifactName": "MyDelivery-${version}-${arch}.${ext}"
    },
    "dmg": { "title": "MyDelivery" }
  }
}
